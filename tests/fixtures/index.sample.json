          "endLine": 17,
          "text": "public ConfirmPayoutCommandValidator()\n    {\n        RuleFor(x => x.PayoutId).NotEmpty();\n        RuleFor(x => x.PspReference).NotEmpty().When(x => x.Succeeded);\n        RuleFor(x => x.FailureReason).NotEmpty().When(x => !x.Succeeded);\n    }"
        },
        {
          "symbol": "ConfirmPayoutHandler.Handle",
          "location": "src/Payments.Application/ConfirmPayout.cs:23",
          "endLine": 37,
          "text": "public async Task<Result> Handle(ConfirmPayoutCommand command, CancellationToken ct)\n    {\n        var payout = await payouts.GetByIdAsync(command.PayoutId, ct);\n        if (payout is null)\n            return Result.Fail(new PayoutNotFoundError(command.PayoutId));\n\n        var result = command.Succeeded\n            ? payout.MarkCompleted(command.PspReference!)\n            : payout.MarkFailed(command.FailureReason!);\n        if (result.IsFailed)\n            return result;\n\n        await payouts.SaveChangesAsync(ct);\n        return Result.Ok();\n    }"
        },
        {
          "symbol": "PayoutRepository.GetByIdAsync",
          "location": "src/Payments.Infrastructure/PaymentsInfrastructure.cs:37",
          "endLine": 38,
          "text": "public Task<Payout?> GetByIdAsync(Guid payoutId, CancellationToken ct) =>\n        db.Payouts.FirstOrDefaultAsync(p => p.Id == payoutId, ct);"
        },
        {
          "symbol": "Payout.MarkCompleted",
          "location": "src/Payments.Domain/Payments.cs:64",
          "endLine": 72,
          "text": "public Result MarkCompleted(string pspReference)\n    {\n        if (Status != PayoutStatus.Pending)\n            return Result.Fail(new PayoutAlreadyFinalizedError(Id, Status));\n\n        Status = PayoutStatus.Completed;\n        PspReference = pspReference;\n        return Result.Ok();\n    }"
        },
        {
          "symbol": "Payout.MarkFailed",
          "location": "src/Payments.Domain/Payments.cs:74",
          "endLine": 82,
          "text": "public Result MarkFailed(string reason)\n    {\n        if (Status != PayoutStatus.Pending)\n            return Result.Fail(new PayoutAlreadyFinalizedError(Id, Status));\n\n        Status = PayoutStatus.Failed;\n        FailureReason = reason;\n        return Result.Ok();\n    }"
        },
